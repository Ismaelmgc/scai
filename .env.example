# Copy to .env (git-ignored). In CI these come from GitHub Actions secrets.

# Polygon.io ("massive") — small-cap daily bars + reference data.
# Free tier: set MASSIVE_CALLS_PER_MINUTE=5 (the job is slower but doesn't fail).
SCAI_POLYGON_API_KEY=
MASSIVE_CALLS_PER_MINUTE=5

# Supabase — source of truth for every paper book (state, NAV, signals, views)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Telegram run summaries / failure alerts (optional; no-op when unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SEC EDGAR requires a descriptive User-Agent with a contact
SEC_EDGAR_USER_AGENT=your-name your-email@example.com

# Tiingo — only for the one-off liquidcap history bootstrap (scripts/liquidcap/download_tiingo.py)
TIINGO_TOKEN=

SCAI_SEED=42
